{
  "contract": "blackhole-screensaver-milestone-2",
  "version": 1,
  "scope": "host-owned-frame-input-seam-schwarzschild-parity",
  "preMilestoneBaseline": {
    "commit": "166ab817f1052436b89ae4b7c5f61718452e9b25",
    "sourcePath": "blackhole_screensaver.c",
    "lineEndingNormalization": "lf",
    "shaderSourceSha256": "7D8472112CAF2FFE7169E1439777E1FE2610538D3C82AEBAD0C7BA44D97A5120"
  },
  "state": {
    "structName": "SceneState",
    "builder": "makeSceneState",
    "uploader": "uploadSceneState",
    "skySeedPolicy": "independent-run-seed-reserved-unconsumed-until-milestone-3",
    "fields": [
      { "name": "elapsedSeconds", "type": "GLfloat", "expression": "(float)(now - g_tick0) / 1000.0f" },
      { "name": "resolutionX", "type": "GLfloat", "expression": "(float)g_W" },
      { "name": "resolutionY", "type": "GLfloat", "expression": "(float)g_H" },
      { "name": "starGain", "type": "GLfloat", "expression": "(float)cfg_starBrightness / 100.0f" },
      { "name": "diskOpacity", "type": "GLfloat", "expression": "(float)cfg_diskOpacity / 100.0f" },
      { "name": "doppler", "type": "GLfloat", "expression": "(float)cfg_doppler / 100.0f" },
      { "name": "sceneSeed", "type": "GLfloat", "expression": "g_sceneSeed" },
      { "name": "skySeed", "type": "GLfloat", "expression": "g_skySeed" }
    ]
  },
  "shader": {
    "sourceSymbol": "shaderSource",
    "headerSymbol": "fragHeader",
    "reservedSkyUniform": "uSkySeed",
    "bodyMustNotContain": ["uSkySeed"],
    "activeUniforms": [
      { "location": "uTime", "shaderName": "iTime", "declaration": "uniform float iTime;", "upload": "glUniform1f(uTime, state->elapsedSeconds);" },
      { "location": "uResolution", "shaderName": "iResolution", "declaration": "uniform vec2  iResolution;", "upload": "glUniform2f(uResolution, state->resolutionX, state->resolutionY);" },
      { "location": "uStarGain", "shaderName": "uStarGain", "declaration": "uniform float uStarGain;", "upload": "glUniform1f(uStarGain, state->starGain);" },
      { "location": "uDiskOpacity", "shaderName": "uDiskOpacity", "declaration": "uniform float uDiskOpacity;", "upload": "glUniform1f(uDiskOpacity, state->diskOpacity);" },
      { "location": "uDoppler", "shaderName": "uDoppler", "declaration": "uniform float uDoppler;", "upload": "glUniform1f(uDoppler, state->doppler);" },
      { "location": "uSceneSeed", "shaderName": "uSceneSeed", "declaration": "uniform float uSceneSeed;", "upload": "glUniform1f(uSceneSeed, state->sceneSeed);" }
    ]
  },
  "render": {
    "function": "renderFrame",
    "timeSample": "ULONGLONG now = GetTickCount64();",
    "stateSnapshot": "const SceneState state = makeSceneState(now);",
    "programBind": "glUseProgram(shaderProgram);",
    "stateUpload": "uploadSceneState(&state);",
    "draw": "glDrawArrays(GL_TRIANGLE_STRIP, 0, 4);"
  }
}
